    {
      "name": "5. Get Employee By ID (GET)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Employee record matches requested ID\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data._id).to.eql(pm.collectionVariables.get(\"createdEmployeeId\"));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/{{createdEmployeeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "{{createdEmployeeId}}"
          ]
        },
        "description": "Fetches a single employee using the dynamic ID saved from the POST request."
      },
      "response": []
    },
    {
      "name": "6. Search Employees (GET with query param)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Search results contain Jonathan\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    var found = jsonData.data.some(e => e.name.includes(\"Jonathan\"));",
              "    pm.expect(found).to.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}?search=Jonathan",
          "host": [
            "{{baseUrl}}"
          ],
          "query": [
            {
              "key": "search",
              "value": "Jonathan"
            }
          ]
        },
        "description": "Searches employees across name, role, department, and email."
      },
      "response": []
    },
    {
      "name": "7. Filter by Department (GET with department filter)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"All returned employees belong to Engineering\", function () {",
              "    var jsonData = pm.response.json();",
              "    jsonData.data.forEach(function(emp) {",
              "        pm.expect(emp.department).to.eql(\"Engineering\");",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}?department=Engineering",
          "host": [
            "{{baseUrl}}"
          ],
          "query": [
            {
              "key": "department",
              "value": "Engineering"
            }
          ]
        },
        "description": "Filters employees strictly by department."
      },
      "response": []
    },
    {
      "name": "8. Sort Employees by Salary Descending (GET)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Salaries are sorted in descending order\", function () {",
              "    var jsonData = pm.response.json();",
              "    for (var i = 0; i < jsonData.data.length - 1; i++) {",
              "        pm.expect(jsonData.data[i].salary).to.be.at.least(jsonData.data[i+1].salary);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}?sortBy=salary&order=desc",
          "host": [
            "{{baseUrl}}"
          ],
          "query": [
            {
              "key": "sortBy",
              "value": "salary"
            },
            {
              "key": "order",
              "value": "desc"
            }
          ]
        },
        "description": "Retrieves employees sorted by salary in descending order."
      },
      "response": []
    },
    {
