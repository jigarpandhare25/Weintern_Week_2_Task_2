{
  "info": {
    "_postman_id": "c8f9b76e-523e-4fa0-82cb-98e3b4a5d892",
    "name": "StaffFlow Pro - Employee Management API",
    "description": "Comprehensive REST API test collection for CRUD Employee Management System.\nFeatures: INR (₹) Currency, Dynamic Department Management, automated test assertions, variable chaining, search, sorting, filtering, and validation error scenarios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/employees",
      "type": "string"
    },
    {
      "key": "deptUrl",
      "value": "http://localhost:5000/api/departments",
      "type": "string"
    },
    {
      "key": "createdEmployeeId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Get All Departments (GET)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Departments list returned as an array\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.data).to.be.an('array');",
              "    pm.expect(jsonData.count).to.be.above(0);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{deptUrl}}",
          "host": [
            "{{deptUrl}}"
          ]
        },
        "description": "Fetches all active departments available in the system."
      },
      "response": []
    },
    {
      "name": "2. Add New Department (POST)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created or 400 if already exists\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([201, 400]);",
              "});",
              "",
              "pm.test(\"Department response handled cleanly\", function () {",
              "    var jsonData = pm.response.json();",
              "    if (pm.response.code === 201) {",
              "        pm.expect(jsonData.success).to.be.true;",
              "        pm.expect(jsonData.data).to.eql(\"Artificial Intelligence\");",
              "    } else {",
              "        pm.expect(jsonData.error).to.include(\"already exists\");",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Artificial Intelligence\",\n  \"description\": \"AI, ML, and Deep Learning Research Division\"\n}"
        },
        "url": {
          "raw": "{{deptUrl}}",
          "host": [
            "{{deptUrl}}"
          ]
        },
        "description": "Creates a new organizational department dynamically."
      },
      "response": []
    },
    {
      "name": "3. Create New Employee - INR (POST)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Employee successfully created with valid ID in INR\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data).to.have.property(\"_id\");",
              "    pm.expect(jsonData.data.name).to.eql(\"Jonathan Archer\");",
              "    pm.expect(jsonData.data.salary).to.eql(1450000);",
              "    ",
              "    pm.collectionVariables.set(\"createdEmployeeId\", jsonData.data._id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Jonathan Archer\",\n  \"email\": \"jonathan.archer@enterprise.org\",\n  \"department\": \"Engineering\",\n  \"role\": \"Lead Propulsion Architect\",\n  \"salary\": 1450000,\n  \"joinDate\": \"2024-03-15\",\n  \"status\": \"Active\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}",
          "host": [
            "{{baseUrl}}"
          ]
        },
        "description": "Creates a new employee with annual salary in Indian Rupees (₹14,50,000)."
      },
      "response": []
    },
    {
      "name": "4. Get All Employees (GET)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response contains employees array\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data).to.be.an('array');",
              "    pm.expect(jsonData.count).to.be.above(0);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}",
          "host": [
            "{{baseUrl}}"
          ]
        },
        "description": "Fetches the full directory of employees."
      },
      "response": []
